# ---------------------------------------------------------------------------
# CODEC — environment
# Copy to .env and fill in. Every value below has a safe local default,
# so the app runs end-to-end with none of the Stripe keys set (MOCK mode).
# ---------------------------------------------------------------------------

# Supabase server configuration. Keep the secret key server-only.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_JWKS_URL="https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json"

# Public origin, used to build Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Stripe ----------------------------------------------------------------
# Leave BLANK to run the payment flow in MOCK mode: bids are recorded and a
# fake deposit reference is issued, with no network call. Fill both in to
# switch to real Stripe Checkout automatically.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Deposit taken when a bid is placed, as a percentage of the bid.
DEPOSIT_PERCENT="20"
DEPOSIT_MINIMUM_USD="50"
