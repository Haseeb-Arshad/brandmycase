# ---------------------------------------------------------------------------
# CODEC — environment
# Copy to .env and fill in. Every value below has a safe local default,
# so the app runs end-to-end with none of the Safepay keys set (MOCK mode).
# ---------------------------------------------------------------------------

# Supabase server configuration. Keep the secret key server-only.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_JWKS_URL="https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json"

# Public origin, used to build Safepay checkout redirect URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Safepay ---------------------------------------------------------------
# Leave all three BLANK to run the payment flow in MOCK mode: bids are recorded
# and a fake deposit reference is issued, with no payment network call. Set all
# three only after Safepay has approved the account and supplied the matching
# environment credentials.
SAFEPAY_PUBLIC_KEY=""
SAFEPAY_SECRET_KEY=""
SAFEPAY_WEBHOOK_SECRET=""
SAFEPAY_ENVIRONMENT="sandbox" # sandbox | production
SAFEPAY_INTENT="CYBERSOURCE"  # CYBERSOURCE | MPGS

# Deposit taken when a bid is placed, as a percentage of the bid.
DEPOSIT_PERCENT="20"
DEPOSIT_MINIMUM_USD="50"
