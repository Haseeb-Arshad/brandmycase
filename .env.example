# ---------------------------------------------------------------------------
# Brand the Case — environment
#
# Copy to .env and fill in. The site runs a fixed-price sponsorship campaign
# with NO payment of any kind on the website: companies send an inquiry,
# Haseeb confirms availability and invoices them directly. Every payment
# variable at the bottom belongs to a dormant future phase and is inert.
#
# Run `npm run preflight` to see exactly what a given environment resolves to.
# ---------------------------------------------------------------------------

# --- Campaign --------------------------------------------------------------
# interest  (default) Sponsorship inquiries, no payment, no checkout.
#                     /api/bids, /api/board and /success all 404.
# auction             The retired bid-and-deposit flow. Do not set this
#                     without reading docs/13-brand-the-case.md.
CAMPAIGN_MODE="interest"

# --- Supabase --------------------------------------------------------------
# Required in production. Sponsorship inquiries are written here, and the
# funding bar reads confirmed sponsorships from here. Keep the secret key
# server-only: it must never appear in a NEXT_PUBLIC_* variable.
#
# With these unset the site still runs: it renders as an unfunded campaign
# with every placement open, and the inquiry form returns a clear error rather
# than silently dropping a company's details.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_JWKS_URL="https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json"

# --- Public site -----------------------------------------------------------
# Required in production. Metadata, canonical URLs and the Open Graph image
# are all derived from this. The production domain is a configuration value,
# never hard-coded in the application.
NEXT_PUBLIC_SITE_URL="https://case.haseeburshad.me"

# The address sponsorship conversations go to. Set a REAL inbox before sending
# this site to a company. If it is unset, the site shows no email address and
# points people at the sponsorship form instead — a working fallback, but not
# the one you want on a page you are pitching from.
NEXT_PUBLIC_CONTACT_EMAIL=""

# --- Founder ---------------------------------------------------------------
# Everything here is optional and renders only when set. A missing link is
# simply not shown; a missing photo becomes a plain monogram. Nothing here is
# invented on your behalf.
NEXT_PUBLIC_FOUNDER_PHOTO=""          # e.g. /haseeb.jpg (put the file in public/)
NEXT_PUBLIC_GITHUB_URL=""
NEXT_PUBLIC_LINKEDIN_URL=""
NEXT_PUBLIC_X_URL=""
NEXT_PUBLIC_WEBSITE_URL=""

# The event date, if you want it stated on the page. Free text, rendered as
# written (e.g. "6 October 2026"). Leave blank and the site simply says the
# event and the city, with no date.
NEXT_PUBLIC_EVENT_DATE=""

# A screenshot of the acceptance confirmation, if you choose to publish one —
# put the file in public/ and point at it (e.g. /acceptance-proof.jpeg).
# Unset, the proof card says the confirmation is available to prospective
# sponsors on request, which is true and is the honest default.
#
# Before publishing one, check the image itself: it must not show the
# registration link, your email address, or anything else personal. Note that a
# screenshot of the real email carries OpenAI's own logo and event artwork —
# that is a decision to make deliberately, not by accident. The independence
# disclosure renders directly beneath it either way.
NEXT_PUBLIC_ACCEPTANCE_PROOF_IMAGE=""

# --- Campaign budget -------------------------------------------------------
# Whole US dollars. Any line you leave blank simply has no figure beside it;
# with none set, the budget section lists the categories and says plainly that
# the split is not published yet. Do not put a number here you have not costed.
NEXT_PUBLIC_BUDGET_TRAVEL_USD=""
NEXT_PUBLIC_BUDGET_ACCOMMODATION_USD=""
NEXT_PUBLIC_BUDGET_TRANSPORT_USD=""
NEXT_PUBLIC_BUDGET_CASE_USD=""
NEXT_PUBLIC_BUDGET_OTHER_USD=""

# --- Analytics (optional) --------------------------------------------------
# A privacy-conscious, cookieless analytics script — Plausible, Fathom and
# Umami all work. BOTH variables must be set or nothing is loaded at all, and
# the site works identically either way. No analytics dependency is installed.
NEXT_PUBLIC_ANALYTICS_SRC=""          # e.g. https://plausible.io/js/script.js
NEXT_PUBLIC_ANALYTICS_DOMAIN=""       # e.g. case.haseeburshad.me

# ---------------------------------------------------------------------------
# FUTURE / DISABLED — Safepay
#
# These do nothing while CAMPAIGN_MODE is `interest`. The payment mode
# resolves to `disabled` regardless of what is set here, and there is no
# public payment surface for them to feed. Leave them blank.
#
# When a future version re-enables the auction: setting all three plus
# CAMPAIGN_MODE=auction resolves to `live`. Setting some of them resolves to
# `misconfigured` and refuses, on purpose. Mock mode requires CAMPAIGN_MODE=
# auction, a non-production NODE_ENV, and no credentials at all — it can never
# be reached by a production visitor.
# ---------------------------------------------------------------------------
SAFEPAY_PUBLIC_KEY=""
SAFEPAY_SECRET_KEY=""
SAFEPAY_WEBHOOK_SECRET=""
SAFEPAY_ENVIRONMENT="sandbox" # sandbox | production
SAFEPAY_INTENT="CYBERSOURCE"  # CYBERSOURCE | MPGS

# Deposit rules for the dormant auction phase. Unused by the campaign.
DEPOSIT_PERCENT="20"
DEPOSIT_MINIMUM_USD="50"
